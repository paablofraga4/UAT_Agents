# LLM (OpenAI / ChatGPT)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
EVIDENCE_DIR=./evidence
SESSIONS_DIR=./sessions
DB_PATH=./storage/uat_agents.db
# Files the agent is allowed to upload into the target app (upload_file action)
UPLOADS_DIR=./uploads

# Domain knowledge base. Curated playbooks (committed) live in KNOWLEDGE_DIR as
# "<domain>.md"; findings the agent accumulates go to KNOWLEDGE_LEARNED_DIR
# (gitignored). Set KNOWLEDGE_LEARNING_ENABLED=false to stop write-back.
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_LEARNED_DIR=./knowledge_learned
KNOWLEDGE_LEARNING_ENABLED=true

# Auth: empty = open (local-first). Set a long random token before exposing
# the backend beyond localhost; the frontend passes it automatically when
# NEXT_PUBLIC_API_TOKEN is set to the same value.
API_TOKEN=

# Browser
HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1366
BROWSER_VIEWPORT_HEIGHT=820
# Explicit Chromium binary (managed/CI environments); empty = Playwright default
BROWSER_EXECUTABLE_PATH=

# Comma-separated domain suffixes the AGENT may navigate to (goto action).
# Empty = unrestricted. Manual navigation in the live view is never restricted.
ALLOWED_DOMAINS=

# Persist cookies/tokens (storage_state) on confirm-login. Off by default;
# when on, the file is 0600 and deleted when the session closes.
PERSIST_STORAGE_STATE=false
